{
  "name": "sugarcommerce/importers",
  "description": "CSV import screens for WordPress plugins, declared as fields: column matching, typed and checked values, a dry run, and batches that stop before the server does.",
  "homepage": "https://github.com/SugarCommerce/importers",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "sugarcommerce/jobs": "dev-main",
    "sugarcommerce/plugin": "dev-main",
    "sugarcommerce/status-badge": "dev-main",
    "sugarcommerce/support": "dev-main",
    "sugarcommerce/text": "dev-main"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "sugarcommerce/fields": "dev-main",
    "sugarcommerce/money": "dev-main",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "suggest": {
    "sugarcommerce/fields": "Draws a tab or operation icon given as `set:name` (`heroicons-outline:users`) as inline SVG, and the screen's own icons as Heroicons rather than Dashicons.",
    "sugarcommerce/geo": "Checks that a country column holds a real ISO 3166-1 code.",
    "sugarcommerce/money": "Checks that a currency column holds a real ISO 4217 code."
  },
  "repositories": [
    {
      "type": "path",
      "url": "../support",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../plugin",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../jobs",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../dates",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../status-badge",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../text",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../fields",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../geo",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../money",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../security",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Importers\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Importers\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php",
      "/tests/stubs.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "test:js": "npm run test:js",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/SugarCommerce/importers/issues",
    "source": "https://github.com/SugarCommerce/importers"
  },
  "keywords": [
    "wordpress",
    "admin",
    "import",
    "csv",
    "batch"
  ]
}
